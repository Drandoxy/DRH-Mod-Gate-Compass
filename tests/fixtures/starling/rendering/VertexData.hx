package starling.rendering;import openfl.geom.Point;class VertexData{public var numVertices=0;var points:Array<Point>=[];var alphas:Array<Float>=[];public function new(format:String,n=0){numVertices=n;}public function clear():Void{numVertices=0;points=[];alphas=[];}public function copyTo(t:VertexData,at=0,m:Dynamic=null,from=0,count=-1):Void{if(count<0)count=numVertices-from;for(i in 0...count){var p=points[from+i];t.points[at+i]=p==null?new Point():new Point(p.x,p.y);t.alphas[at+i]=alphas[from+i];}t.numVertices=Std.int(Math.max(t.numVertices,at+count));}public function setPoint(i:Int,name:String,x:Float,y:Float):Void{points[i]=new Point(x,y);numVertices=Std.int(Math.max(numVertices,i+1));}public function getPoint(i:Int,name:String,out:Point):Point{var p=points[i];out.x=p.x;out.y=p.y;return out;}public function setColor(i:Int,name:String,c:UInt):Void{}public function setAlpha(i:Int,name:String,a:Float):Void{alphas[i]=a;}}