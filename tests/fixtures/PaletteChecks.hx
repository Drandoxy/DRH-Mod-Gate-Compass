import mods.gate_compass.PaletteTransform;
class PaletteChecks{static function main(){for(color in [0x00DFFF,0x8855FF,0xFFB800,0xFF40CA,0xFF7138]){var m=PaletteTransform.matrix(color);for(i in 0...256){var t=i/255.;var r=Math.round(136+(255-136)*t);var g=Math.round(233+(255-233)*t);var b=Math.round(231+(255-231)*t);var pigment=Math.min(1.,(Math.max(r,Math.max(g,b))-Math.min(r,Math.min(g,b)))/119.);var targets=[(color>>16)&255,(color>>8)&255,color&255];var base=[136,233,231];var source=[r,g,b];for(c in 0...3){var expected=Math.max(0,Math.min(255,source[c]+(targets[c]-base[c])*pigment));var at=c*5;var actual=Math.max(0,Math.min(255,m[at]*r+m[at+1]*g+m[at+2]*b));if(Math.abs(expected-actual)>.00001)throw "palette transform changed pigment";}}}trace("PASS: native colour matrix matches previous cyan/white pigment maths across themes");}}
