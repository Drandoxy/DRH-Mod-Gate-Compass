import mods.gate_compass.*;
import mods.api.dungeon.Tile;
import openfl.geom.Point;
@:access(mods.gate_compass.WalkGrid)
class HeadingChecks{static function main(){var g=new WalkGrid();g.width=30;g.height=30;g.left=0;g.top=0;g.step=10;var t=new Tile("room",0,0);g.cells=[for(i in 0...900)true];g.rooms=[for(i in 0...900)t];g.nearCollider=[for(i in 0...900)false];g.routeLine=[new Point(0.,0.),new Point(100.,0.),new Point(100.,250.)];var target=g.followLine(0,0);if(target==null||Math.abs(g.routeDirection.x-100)>.001||Math.abs(g.routeDirection.y)>.001)throw "compass used distant line heading instead of hero+15 averaged";g.followLine(98,0);if(g.routeDirection.x<0||g.routeDirection.y<95)throw "15-unit chord failed across corner";g.followLine(100,248);if(Math.abs(g.routeDirection.y-100)>.001)throw "end-of-line heading lost";g.routeLine=[new Point(0.,0.),new Point(4.,0.),new Point(4.,1.),new Point(8.,1.),new Point(8.,0.),new Point(30.,0.)];g.followLine(0,0);if(g.routeDirection.x<99||Math.abs(g.routeDirection.y)>.001)throw "tiny segments changed averaged heading";g.routeDirection=new Point(100.,0.);g.routeLine=[new Point(100.,100.),new Point(0.,100.),new Point(0.,0.)];for(row in 0...30)g.cells[row*30+5]=false;if(g.followLine(100,100)!=null)throw "blocked candidate accepted";if(g.routeDirection.x!=100||g.routeDirection.y!=0)throw "rejected candidate overwrote the active heading";trace("PASS: hidden hero+15 averaged route heading, corner crossing and terminal tangent independent of visible line start");}}
